[Unit]
Description=CSIG Agent Memory Leaderboard API
After=network-online.target csig-aml-proxy.service
Requires=csig-aml-proxy.service

[Service]
Type=simple
WorkingDirectory=/home/agent/csig-aml/current
ExecStart=/home/agent/csig-aml/.venv/bin/python -m uvicorn memory.aml_api:app --host 0.0.0.0 --port 18092 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
