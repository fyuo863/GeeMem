# Configuration is read ONLY from the project root .env; no environment overrides or interpolation.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MEMORY_DB=data/memory.sqlite3

# Optional explicit HTTP proxy, e.g. http://127.0.0.1:7897
LLM_PROXY=

# Dedicated Agent Memory Leaderboard Textual adapter (memory.aml_api:app)
AML_AUTH_MODE=bearer
AML_API_KEY=
AML_ALLOW_UNAUTHENTICATED=false
AML_MEMORY_DB=data/aml/memory.sqlite3
AML_ADD_CONCURRENCY=1
AML_SEARCH_CONCURRENCY=4
# For scripts/smoke_aml.py --live; use your own deployed adapter URL, not the leaderboard.
AML_BASE_URL=
AML_HTTP_PROXY=
