# Configuration is read ONLY from the project root .env; no environment overrides or interpolation.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MEMORY_DB=data/memory.sqlite3

# Optional explicit HTTP proxy, e.g. http://127.0.0.1:7897
LLM_PROXY=

# Dedicated Agent Memory Leaderboard Textual adapter (memory.aml_api:app)
AML_AUTH_MODE=bearer
AML_API_KEY=
AML_ALLOW_UNAUTHENTICATED=false
AML_MEMORY_DB=data/aml/memory.sqlite3
# Nonnegative integer, no hard-coded maximum. 0 disables application admission
# limiting; database locks, ASGI thread pool and upstream quotas still apply.
AML_ADD_CONCURRENCY=1
AML_SEARCH_CONCURRENCY=4
# For scripts/smoke_aml.py --live; use your own deployed adapter URL, not the leaderboard.
AML_BASE_URL=
AML_HTTP_PROXY=

# v1 retrieval backend. Settings are read only from root .env.
MEMORY_BACKEND=vanilla
RAG_MEMORY_DB=data/aml/text-embedding-v4.sqlite3
RAG_MODEL_PATH=data/models/bge-small-en-v1.5
RAG_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
RAG_DEVICE=cpu
RAG_DOWNLOAD_PROXY=
RAG_CHUNK_TOKENS=320
RAG_CHUNK_OVERLAP=40
RAG_RETRIEVAL_MODE=hybrid
RAG_RRF_K=60
RAG_LEXICAL_WEIGHT=0.5
RAG_RESULT_WINDOW=0
RAG_RESULT_WINDOW_SEED_K=20

# Rule-keyword experiment (no LLM calls). off preserves the original v1 retrieval.
RAG_TAG_MODE=off
RAG_TAG_CANDIDATES=400

# Optional semantic keyword modes: semantic_filter or semantic_rank (local BGE only).
RAG_TAG_WEIGHT=0.5
RAG_TAG_THRESHOLD=0.5

# Optional local cross-encoder. Keep window=0 for pure top-k reranking.
RAG_RERANK_MODE=local
# Optional native Qwen API (local mode selects HTTP when URL is nonblank).
# Set selection=direct and target_mode=off for request-relative API scores.
# Keep an entire pool <=500 in one request; never concatenate batch scores.
RAG_RERANK_API_PROTOCOL=dashscope
RAG_RERANK_API_URL=
RAG_RERANK_API_MODEL=qwen3.7-text-rerank
RAG_RERANK_API_KEY=
RAG_RERANK_API_PROXY=
RAG_RERANK_API_TIMEOUT=60
RAG_RERANK_API_RETRIES=1
RAG_RERANK_PATH=data/models/ms-marco-MiniLM-L-6-v2
RAG_RERANK_DEVICE=cpu
RAG_RERANK_CANDIDATES=400
# Optional local ONNX: install project[onnx], set RAG_RERANK_MODE=onnx,
# RAG_RERANK_PATH to the existing snapshot, and generate a checksum manifest.
# RAG_RERANK_MANIFEST=data/models/bge-reranker-base-onnx-manifest.json
# RAG_RERANK_THREADS=4
# For BGE target-only experiments: RAG_RERANK_CONTEXT=0, RAG_RERANK_BATCH_SIZE=8.
RAG_RERANK_CONTEXT=1
RAG_RERANK_BATCH_SIZE=32
RAG_RERANK_MAX_LENGTH=512

# context_support requires rerank context=1 and result window=0.
RAG_RERANK_SELECTION=context_support
RAG_RERANK_NEIGHBOR_PENALTY=2
RAG_TARGET_PENALTY_SCALE=1
RAG_SECOND_PASS_TOP_THRESHOLD=4
RAG_SECOND_PASS_GAP_THRESHOLD=2
RAG_METADATA_MODE=on
RAG_TARGET_MODE=on
RAG_SECOND_PASS=on
RAG_QUERY_INSTRUCTION=

# Selected configuration: ABC + fusion/QA + soft recall (options 1 + 3).
# Set all three to off to reproduce the frozen ABC baseline.
RAG_FUSION_QA=on
RAG_MULTI_QUERY=off
RAG_SOFT_RECALL=on

# Academic-track embedding (requires a Model Studio API key).
# Use your account region's endpoint and a NEW database; do not reuse BGE vectors.
RAG_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
RAG_EMBEDDING_API_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_API_PROXY=
RAG_QUERY_PREFIX=

# Selected long-prompt multihop release; off restores direct retrieval.
# Uses only root .env LLM_MODEL=gpt-4o-mini / LLM_API_KEY / LLM_BASE_URL / LLM_PROXY.
# Requires a reranker and RAG_RESULT_WINDOW=0. Add never invokes this planner.
RAG_MULTIHOP_MODE=llm
# Partition routing experiment: off / strict / dual. Set multihop off to use it.
# dual reserves half of the existing rerank candidate budget for selected types.
RAG_PARTITION_MODE=off
# Experimental prompt comparison: long (original), short, focused (one need per read).
RAG_MULTIHOP_PROMPT_STYLE=long
RAG_MULTIHOP_ROUNDS=3
RAG_MULTIHOP_QUERIES=6
RAG_MULTIHOP_CANDIDATES=20
RAG_MULTIHOP_EVIDENCE=12
RAG_MULTIHOP_EVIDENCE_CHARS=1200
RAG_MULTIHOP_LLM_TIMEOUT=20
RAG_MULTIHOP_SECONDS=90
# Selected source binding and evidence-needs checks from the long-prompt comparison.
RAG_MULTIHOP_BINDINGS=on
RAG_MULTIHOP_NEEDS=on
# Includes routing, evidence reviews, and at most one repair per Search.
RAG_MULTIHOP_LLM_CALLS=8

RAG_MULTIHOP_RECOVERY=off

RAG_MULTIHOP_RECOVERY_BUDGET=2

RAG_MULTIHOP_RECOVERY_PER_HOP=1

# Experimental source time mentions; defaults off until retrieval gains are validated.
# Reads only this project's .env. Does not change /search response shape.
RAG_TEMPORAL_MODE=off
# Optional gpt-4o-mini span selection, at most 2 sources/Add, <=6000 chars/source.
# Up to 2 transport attempts/call, 60s HTTP timeout; failure retains rule spans.
# Date normalization/comparison is always deterministic. Unknown dates stay unknown.
RAG_TIME_ANNOTATION_MODE=off

# Supports off / absolute_query / window (absolute query + 70% time-window pool).
# Requires RAG_TEMPORAL_MODE=on; global candidates fill unused window slots.
# Optional /search reference_time (epoch ms) and reference_timezone (default UTC).
RAG_TEMPORAL_EXPERIMENT=off
# Window strategy: bounded temporal/semantic fusion and final TopK soft quota.
RAG_TEMPORAL_FUSION_WEIGHT=0.10
RAG_TEMPORAL_WINDOW_RATIO=0.50
RAG_TEMPORAL_CONTEXT=1

# Query-time state/correction/rule evidence selector (pilot, no persistent facts).
# At most one additional gpt-4o-mini call, 20s HTTP timeout, no retries.
# <=16 sources x600 chars, <=1500-char questions; errors retain baseline ranking.
RAG_STATE_EVIDENCE_MODE=off

# Assemble 2-4 final reviewed sources before Top-K (long/short multihop only).
# <=6000 characters incl. source headers; zero additional model calls.
# Local pilot; competition bundle granularity has not been officially confirmed.
RAG_EVIDENCE_BUNDLE_MODE=off

# Local controls pilot: only published writes, one pinned version per Search.
RAG_VERSION_MODE=off
# mask covers basic structured PII/credentials in retrieval text; no user override.
# Does not mask ingestion before embedding/classification provider calls.
RAG_DISCLOSURE_MODE=off
# At most one rule/stage supplemental query, charged to multihop query budget.
RAG_SUPPLEMENTAL_MODE=off

# Rule questions: reserve one existing multihop LLM call for applicability.
# <=12 candidates x900 chars; <=20 seconds; failure/unknown recorded in trace.
# Unchecked tail candidates are omitted after a successful applicability review.
RAG_RULE_APPLICABILITY_MODE=off
# Explicit corrections only; requires RAG_VERSION_MODE=on. Append-only relations.
# <=2 new chunks/Add x4 prior candidates; 20s/call, no automatic retries.
RAG_FACT_REPLACEMENT_MODE=off
# Segment-index classification; requires RAG_DISCLOSURE_MODE=mask.
# <=2 calls/Add x8 chunks x900 chars; 20s/call; missing/failed labels excluded.
# Legacy sources require classification before enabling against an existing DB.
# Repeating the original Add retries missing annotations without duplicate vectors.
RAG_SEMANTIC_PRIVACY_MODE=off
# Trusted service identity, never taken from query/user_id. No grants by default.
RAG_DISCLOSURE_PRINCIPAL=anonymous
# JSON shape: {"service-principal":{"user-id":["health"]}}. No wildcard grants.
# Credential/basic pattern masks cannot be overridden by these semantic grants.
RAG_DISCLOSURE_GRANTS={}

# Experimental source-grounded evidence chains. Keep off until workload validation.
# Requires standard long/short review and RAG_MULTIHOP_BINDINGS=off, RAG_MULTIHOP_NEEDS=off.
# Enable RAG_EVIDENCE_BUNDLE_MODE=on to deliver multiple raw sources in one result.
RAG_EVIDENCE_CHAIN_MODE=off
